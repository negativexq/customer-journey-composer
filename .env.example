# Run make setup to create an ignored .env with a random local database password.
POSTGRES_DB=journeys
POSTGRES_USER=journey
POSTGRES_PASSWORD=
POSTGRES_PORT=54329
DATABASE_URL=
HTTP_ADDR=:8090
API_PORT=8090
WEB_PORT=5173
MAILPIT_PORT=8025
SMTP_PORT=1025
LOG_LEVEL=info
# Optional AI providers. Live LLM tests are deferred.
AI_PROVIDER=disabled
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

COOKIE_SECURE=false
SMTP_HOST=127.0.0.1
SMTP_DOCKER_HOST=mailpit
SMTP_SERVER_PORT=1025
SMTP_FROM=journeys@localhost.invalid
SMTP_USER=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=false
# Hosts webhook steps may call (comma-separated). Empty: calls are recorded, never sent.
WEBHOOK_ALLOWED_HOSTS=

# Local demo only. setup generates the password into ignored .env.
APP_ENV=development
DEMO_ENABLED=true
DEMO_EMAIL=demo@example.invalid
DEMO_PASSWORD=

# Production signup remains closed unless explicitly enabled.
PUBLIC_SIGNUP=false
# Per-workspace event ingestion limit (requests/s and burst); blank keeps 500 and 1000.
INGEST_RATE_PER_SECOND=
INGEST_BURST=
# Public address for tracked links, open pixels and unsubscribe links in sent messages.
PUBLIC_BASE_URL=http://localhost:5173
# Shared secret for signed provider delivery reports (POST /api/provider/events). Empty = off.
PROVIDER_WEBHOOK_SECRET=
# Optional collector. Blank endpoint means no trace export.
# Native metrics: set METRICS_ADDR per process (API 9464, worker 9465).
# Docker metrics listen internally on 9464; no host port is published.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_SDK_DISABLED=false

# Optional local observability overlay. Generated by make setup.
GRAFANA_ADMIN_PASSWORD=
