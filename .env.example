# Run make setup to create an ignored .env with a random local database password.
POSTGRES_DB=journeys
POSTGRES_USER=journey
POSTGRES_PASSWORD=
POSTGRES_PORT=54329
DATABASE_URL=
HTTP_ADDR=:8090
API_PORT=8090
WEB_PORT=5173
MAILPIT_PORT=8025
SMTP_PORT=1025
LOG_LEVEL=info
# Optional AI providers. Live LLM tests are deferred.
AI_PROVIDER=disabled
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

COOKIE_SECURE=false
SMTP_HOST=127.0.0.1
SMTP_DOCKER_HOST=mailpit
SMTP_SERVER_PORT=1025
SMTP_FROM=journeys@localhost.invalid
SMTP_USER=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=false

# Local demo only. setup generates the password into ignored .env.
APP_ENV=development
DEMO_ENABLED=true
DEMO_EMAIL=demo@example.invalid
DEMO_PASSWORD=
