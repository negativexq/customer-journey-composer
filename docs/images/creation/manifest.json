    "schema_version": "composer.v5",
    "name": "Abandoned Cart Recovery",
    "description": "After an eligible EUR cart is updated, wait one hour and send a consent-checked personal email. Then monitor for a purchase of that same cart for 24 hours. A matching purchase ends the journey as converted; otherwise, send a consent-checked 10% SMS offer and complete. Re-entry is blocked for seven days.",
    "workflow": {
      "behavior_checks": {
        "version": 2,
        "confirmed": true,
        "entry_event": "cart_updated",
        "inputs": {
          "customer.attributes.first_name": "Alex",
          "event.properties.amount": 89.9,
          "event.properties.amount_display": "€89.90",
          "event.properties.cart_id": "CART-ALEX-001",
          "event.properties.currency": "EUR"
        },
        "email_count": 1,
        "sms_count": 1,
        "outcome": "completed",
        "duration_seconds": 90000,
        "case_name": "No purchase during recovery",
        "conditions": [
          {
            "path": "event.properties.amount",
            "operator": "greater_than_or_equal",
            "value": 50
          },
          {
            "path": "event.properties.currency",
            "operator": "equals",
            "value": "EUR"
          }
        ],
        "consents": {
          "email": true,
          "sms": true
        },
        "alternatives": [
          {
            "name": "Purchase before the first reminder",
            "events": [
              {
                "entry_binding": {
                  "entry_path": "event.properties.cart_id",
                  "event_path": "event.properties.cart_id",
                  "operator": "equals"
                },
                "event_name": "purchase_completed",
                "after_seconds": 1800,
                "properties": {
                  "cart_id": "CART-ALEX-001"
                }
              }
            ],
            "email_count": 0,
            "sms_count": 0,
            "outcome": "converted",
            "duration_seconds": 1800
          }
        ]
      },
      "schema_version": 1,
