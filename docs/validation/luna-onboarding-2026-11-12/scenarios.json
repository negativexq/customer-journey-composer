[
  {
    "id": 1,
    "scenario": {
      "name": "A · Already activated at entry",
      "start_time": "2026-11-12T09:00:00Z",
      "customer": {
        "customer_id": "onboarding_demo",
        "email": "alex@example.invalid",
        "phone": "+15005550006",
        "attributes": {
          "first_name": "Alex",
          "product_name": "Atlas",
          "activated": true
        },
        "consents": {
          "email": true,
          "sms": true
        }
      },
      "entry_event": {
        "event_id": "register_1",
        "event_name": "user_registered",
        "properties": {}
      },
      "frequency_limit": 10,
      "frequency_window_seconds": 86400,
      "assertions": [
        {
          "type": "no_duplicate_delivery",
          "expected": true
        },
        {
          "type": "message_count",
          "channel": "email",
          "expected": 0
        },
        {
          "type": "message_count",
          "channel": "sms",
          "expected": 0
        },
        {
          "type": "exit_reason",
          "expected": "converted"
        }
      ]
    },
    "expected_elapsed_seconds": 0
  },
